# ============================================================================
#  Kajalworld — Environment template. Copy to .env.local and fill in.
#  NEVER commit .env.local. NEVER expose SERVICE_ROLE key to the browser.
# ============================================================================

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC) ---
# Used only in server-side route handlers / server actions for privileged ops
# (moderation, quota enforcement). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin bootstrap (optional) ---
# Email of the user allowed into /admin. Enforced server-side via allowlist
# and Supabase Auth. Create this user in Supabase Auth, then set here.
ADMIN_ALLOWED_EMAILS=you@example.com
